<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CountrySearch</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/StyleSheet.css" asp-append-version="true">
</head>

<body>
    <nav class="navbar navbar-expand-lg app-navbar">
        <div class="container">

            <a class="navbar-brand" href="/">
                <span class="brand-icon">
                    <i class="bi bi-globe-americas"></i>
                </span>
                CountrySearch
            </a>

            <form method="get" class="nav-search">
                <input name="Name"
                       type="search"
                       placeholder="Buscar país..."
                       value="@Context.Request.Query["Name"]">

                <button type="submit">
                    <i class="bi bi-search"></i>
                    Buscar
                </button>
            </form>

        </div>
    </nav>

    <header class="hero">
        <div class="hero-overlay"></div>

        <div class="container hero-content">

            <div class="hero-text">
                <span class="eyebrow">
                    <i class="bi bi-compass"></i>
                    Explora países del mundo
                </span>

                <h1>Descubre países, banderas e información en segundos.</h1>

                <p>
                    Una experiencia moderna para buscar países y conocer información básica
                    de una forma clara, rápida y elegante.
                </p>

                <form method="get" class="hero-search">
                    <input name="Name"
                           type="search"
                           placeholder="Escribe el nombre de un país..."
                           value="@Context.Request.Query["Name"]">

                    <button type="submit">
                        <i class="bi bi-search"></i>
                        Buscar ahora
                    </button>
                </form>
            </div>

            <div class="hero-card">
                <i class="bi bi-globe2"></i>
                <h3>Country Explorer</h3>
                <p>Busca, compara y explora países visualmente.</p>

                <div class="stats">
                    <div>
                        <strong>@Model.Count()</strong>
                        <span>Países</span>
                    </div>
                    <div>
                        <strong>24/7</strong>
                        <span>Disponible</span>
                    </div>
                </div>
            </div>

        </div>
    </header>

    <main class="container countries-area">

        <div class="section-title">
            <span>Resultados</span>
            <h2>Países disponibles</h2>
            <p>Selecciona un país para ver más información.</p>
        </div>

        <div>
            @RenderBody()
        </div>
    </main>

</body>
</html>
